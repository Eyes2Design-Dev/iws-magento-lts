<script type="text/javascript">
    var optionsPrice = new Product.OptionsPrice(<?php echo $this->getJsonConfig() ?>);
    document.observe('dom:loaded', function(){
        $$(".plusminus .plusminus-plus").invoke("observe", 'click', function(event){
            var val = this.up(1);
            var val1 = val.down("input.qty").value;
            val.down("input.qty").setAttribute("value", parseInt(val1, 10)+1);
        });
        $$(".plusminus .plusminus-minus").invoke("observe", 'click', function(event){
            var val = this.up(1);
            var val1 = val.down("input.qty").value;
            if(parseInt(val1, 10) > 1){
                val.down("input.qty").setAttribute("value", parseInt(val1, 10)-1);
            }
        });
    });
</script>
